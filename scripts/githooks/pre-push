#!/bin/sh
# Refuse any push that would update a remote ref other than refs/heads/shreyas.
# Enabled with: git config core.hooksPath scripts/githooks
# Reads other branches freely (fetch/merge are unaffected). A human can bypass once with ALLOW_ANY_PUSH=1.
[ "${ALLOW_ANY_PUSH:-0}" = "1" ] && exit 0
status=0
while read local_ref local_sha remote_ref remote_sha; do
  [ -z "$remote_ref" ] && continue
  if [ "$remote_ref" != "refs/heads/shreyas" ]; then
    echo "pre-push: BLOCKED push to '$remote_ref' (only refs/heads/shreyas is allowed from this clone)" >&2
    status=1
  fi
done
exit $status
